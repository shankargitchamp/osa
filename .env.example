# Sentinel Overwatch Backend Environment Variables

# Flask secret key
SECRET_KEY=your_secret_key_here

# Email/Resend
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=your_email@domain.com
EMAIL_ENABLED=False
EMAIL_RECIPIENTS=user1@domain.com,user2@domain.com

# Slack
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL=#your-slack-channel
SLACK_ENABLED=False
SLACK_WEBHOOK_URL=

# Detection/Alert
DETECTION_THRESHOLD=0.7
ALERT_COOLDOWN_MINUTES=5

# Attack patterns (optional, as JSON string)
# ATTACK_PATTERNS={"ransomware": {"enabled": true, "churn_threshold": 100}, "fork_bomb": {"enabled": true, "spawn_threshold": 50}, "crypto_miner": {"enabled": true, "cpu_threshold": 80}, "privilege_escalation": {"enabled": true}, "reverse_shell": {"enabled": true}}

# LLM API (if used)
EMERGENT_LLM_KEY=your_llm_api_key_here

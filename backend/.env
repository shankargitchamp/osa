# App secret (use a strong random value)
SECRET_KEY=4758d163fed2bf5e2aceef3bf1ecae7cc9a40f5895f59eae3a3281ca6a402d62

# Gemini LLM (backend-only secret)
GEMINI_API_KEY=your_gemini_api_key_here
